{
  "name": "florrie-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "AI-first salon operating system",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "check:node": "node scripts/check-node-floor.mjs",
    "build": "npm run check:lockfile && npm run check:node && npm run build:shared && npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "build:shared": "cd shared && npm run build",
    "db:migrate": "node backend/scripts/migrate.js up",
    "db:reset": "cd supabase && npx supabase db reset",
    "test": "npm run test --workspace backend",
    "migrate": "node backend/scripts/migrate.js up",
    "migrate:status": "node backend/scripts/migrate.js status"
  },
  "devDependencies": {
    "pg": "^8.20.0"
  },
  "overrides": {
    "tar": "^7.5.22",
    "uuid": "^11.1.1"
  }
}
