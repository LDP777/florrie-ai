# Staging environment — separate from production
# Use a separate Supabase project (or Supabase branch on Pro plan)
# Use Stripe test mode keys (sk_test_xxx, not sk_live_xxx)
# Use a separate Railway service in the same project (florrie-api-staging)

# Supabase — staging project (NOT the production project)
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_KEY=your-staging-service-role-key

# Stripe — ALWAYS test keys in staging
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# WhatsApp — can reuse production WABA token; staging won't send to real users
# if you point it at a test phone number
WHATSAPP_TOKEN=your-system-user-permanent-token
WHATSAPP_WABA_ID=your-waba-id
WHATSAPP_VERIFY_TOKEN=florrie-webhook-verify-staging
WHATSAPP_API_VERSION=v19.0

# Instagram
INSTAGRAM_TOKEN=your-token

# Anthropic — same key is fine, staging just uses fewer tokens
ANTHROPIC_API_KEY=your-key

# Resend — use a staging FROM address so staging emails are identifiable
RESEND_API_KEY=re_xxx
FROM_EMAIL=Florrie Staging <staging@florrie.ai>

# Twilio
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx

# Bird SMS
BIRD_API_KEY=your-bird-api-key
BIRD_ORIGINATOR=FlorrieStg

# Google Calendar
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_REDIRECT_URI=https://florrie-api-staging.up.railway.app/api/gcal/callback

# Cron
CRON_SECRET=your-staging-cron-secret

# Server
PORT=3001
FRONTEND_URL=https://florrie-staging.vercel.app
NODE_ENV=staging

# Sentry — use a separate staging project in Sentry so staging errors don't
# pollute production alerts
SENTRY_DSN=
