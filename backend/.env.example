# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# WhatsApp (Meta Cloud API — Florrie's WABA, beauticians register their own numbers)
WHATSAPP_TOKEN=your-system-user-permanent-token
WHATSAPP_WABA_ID=your-waba-id
WHATSAPP_VERIFY_TOKEN=florrie-webhook-verify
WHATSAPP_API_VERSION=v19.0

# Instagram (Meta Graph API)
INSTAGRAM_TOKEN=your-token

# Anthropic (Claude API)
ANTHROPIC_API_KEY=your-key

# Resend (Email)
RESEND_API_KEY=re_xxx
FROM_EMAIL=Florrie <noreply@florrie.ai>

# Twilio (WhatsApp config only — SMS has moved to Bird)
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx

# Bird / MessageBird (SMS)
# Sign up at bird.com — no regulatory bundle required for UK
# BIRD_ORIGINATOR can be an alphanumeric sender name (max 11 chars) or a real number
BIRD_API_KEY=your-bird-api-key
BIRD_ORIGINATOR=Florrie

# Google Calendar
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_REDIRECT_URI=http://localhost:3001/api/gcal/callback

# Cron
CRON_SECRET=your-random-secret-here

# Sentry (error monitoring — get DSN from sentry.io after creating a Node.js project)
# Leave blank in local dev to disable. Set in Railway env vars for production.
SENTRY_DSN=

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
