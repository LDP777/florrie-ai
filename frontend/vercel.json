{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!landing\\.html|assets/|favicon|apple-touch|manifest|og-image|sw|workbox|florrie-).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!landing\\.html|assets/|favicon|apple-touch|manifest|og-image|sw|workbox|florrie-).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/landing.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}