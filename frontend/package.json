    "test:e2e": "playwright test",
    "test:e2e:booking": "playwright test --project=booking",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "native:build": "vite build && npx cap sync",
    "check:icons": "node scripts/check-icons.mjs",
    "check:drag": "node scripts/check-drag.mjs",
    "check:primitives": "node scripts/check-primitives.mjs",
    "check:tap": "node scripts/check-tap-inventory.mjs",
    "check:tap:browser": "node scripts/check-tap-targets.mjs",
    "check:icon-usage": "node scripts/check-icon-usage.mjs",
    "check:chrome": "node scripts/check-chrome.mjs"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@sentry/react": "^8.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "exceljs": "^4.4.0",
    "posthog-js": "^1.369.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.2",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0"
  },
  "capacitor": {
    "appId": "ai.florrie.app",
