{
  "name": "@florrie/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:icons && npm run check:icon-usage && npm run check:chrome && npm run check:primitives && npm run check:tap && vite build",
