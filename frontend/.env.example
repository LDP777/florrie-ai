# Supabase — get from supabase.com > project > API settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend API URL
# Local dev: http://localhost:3001
# Production: your Railway service URL
VITE_API_URL=http://localhost:3001

# Sentry (error monitoring — get DSN from sentry.io after creating a React project)
# Leave blank in local dev to disable. Set in Vercel env vars for production.
VITE_SENTRY_DSN=
